# Copia questo file in `apps/web/.env` e compila i valori.
# Le variabili sono validate a runtime da `packages/env/src/server.ts`:
# se una manca o non rispetta il formato, l'app non parte.

# Connessione PostgreSQL.
# Il default corrisponde al container definito in packages/db/docker-compose.yml
# (avviabile con `pnpm run db:start`).
DATABASE_URL=postgresql://postgres:password@localhost:5432/page_builder

# Segreto usato da Better-Auth per firmare sessioni e token.
# Minimo 32 caratteri. Generane uno con: openssl rand -base64 32
BETTER_AUTH_SECRET=

# URL pubblico dell'app, usato da Better-Auth per callback e cookie.
# In sviluppo coincide con la porta di `next dev` (3001).
BETTER_AUTH_URL=http://localhost:3001

# Origin autorizzato per le richieste cross-origin verso le API.
CORS_ORIGIN=http://localhost:3001

# Origin da cui il BROWSER raggiunge le API. Esposto al bundle client
# (prefisso NEXT_PUBLIC_), validato da `packages/env/src/web.ts`.
# In sviluppo coincide con BETTER_AUTH_URL.
# ⚠️ In RELEASE (immagine Docker) questa è l'UNICA variabile build-time:
# viene sostituita a build time nel bundle client, quindi si passa come
# build-arg al Dockerfile (--build-arg NEXT_PUBLIC_SERVER_URL=...).
# Tutte le altre variabili sono runtime-only (compose `environment`):
# lo stesso artefatto gira in dev/staging/prod cambiando solo l'env.
NEXT_PUBLIC_SERVER_URL=http://localhost:3001
