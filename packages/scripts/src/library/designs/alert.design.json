{
  "parts": {
    "root": {
      "kind": "board",
      "size": [
        360,
        80
      ],
      "dir": "column",
      "align": "start"
    },
    "heading": {
      "kind": "text",
      "parent": "root",
      "text": "Heading"
    },
    "description": {
      "kind": "text",
      "parent": "root",
      "text": "Description"
    }
  },
  "cells": {
    "status=info": {
      "root": {
        "fill": "color.card",
        "borderRadiusTopLeft": "radius.lg",
        "borderRadiusTopRight": "radius.lg",
        "borderRadiusBottomRight": "radius.lg",
        "borderRadiusBottomLeft": "radius.lg",
        "paddingTop": "spacing.4",
        "paddingBottom": "spacing.4",
        "paddingLeft": "spacing.4",
        "paddingRight": "spacing.4"
      },
      "heading": {
        "fill": "color.info",
        "fontSize": "text.sm",
        "fontWeight": "font-weight.semibold",
        "letterSpacing": "tracking.none"
      },
      "description": {
        "fill": "color.card-foreground",
        "fontSize": "text.sm",
        "fontWeight": "font-weight.regular",
        "letterSpacing": "tracking.none"
      }
    },
    "status=success": {
      "root": {
        "fill": "color.card",
        "borderRadiusTopLeft": "radius.lg",
        "borderRadiusTopRight": "radius.lg",
        "borderRadiusBottomRight": "radius.lg",
        "borderRadiusBottomLeft": "radius.lg",
        "paddingTop": "spacing.4",
        "paddingBottom": "spacing.4",
        "paddingLeft": "spacing.4",
        "paddingRight": "spacing.4"
      },
      "heading": {
        "fill": "color.success",
        "fontSize": "text.sm",
        "fontWeight": "font-weight.semibold",
        "letterSpacing": "tracking.none"
      },
      "description": {
        "fill": "color.card-foreground",
        "fontSize": "text.sm",
        "fontWeight": "font-weight.regular",
        "letterSpacing": "tracking.none"
      }
    },
    "status=warning": {
      "root": {
        "fill": "color.card",
        "borderRadiusTopLeft": "radius.lg",
        "borderRadiusTopRight": "radius.lg",
        "borderRadiusBottomRight": "radius.lg",
        "borderRadiusBottomLeft": "radius.lg",
        "paddingTop": "spacing.4",
        "paddingBottom": "spacing.4",
        "paddingLeft": "spacing.4",
        "paddingRight": "spacing.4"
      },
      "heading": {
        "fill": "color.warning",
        "fontSize": "text.sm",
        "fontWeight": "font-weight.semibold",
        "letterSpacing": "tracking.none"
      },
      "description": {
        "fill": "color.card-foreground",
        "fontSize": "text.sm",
        "fontWeight": "font-weight.regular",
        "letterSpacing": "tracking.none"
      }
    },
    "status=error": {
      "root": {
        "fill": "color.card",
        "borderRadiusTopLeft": "radius.lg",
        "borderRadiusTopRight": "radius.lg",
        "borderRadiusBottomRight": "radius.lg",
        "borderRadiusBottomLeft": "radius.lg",
        "paddingTop": "spacing.4",
        "paddingBottom": "spacing.4",
        "paddingLeft": "spacing.4",
        "paddingRight": "spacing.4"
      },
      "heading": {
        "fill": "color.destructive",
        "fontSize": "text.sm",
        "fontWeight": "font-weight.semibold",
        "letterSpacing": "tracking.none"
      },
      "description": {
        "fill": "color.card-foreground",
        "fontSize": "text.sm",
        "fontWeight": "font-weight.regular",
        "letterSpacing": "tracking.none"
      }
    }
  }
}
