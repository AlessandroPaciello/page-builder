{
  "name": "@penpot-ds/scripts",
  "version": "0.0.0",
  "private": true,
  "description": "Pipeline MCP Penpot\u2192codice: Stage 1 genera i token di @penpot-ds/tokens, Stage 2 estrae per-componente fixture e ricette validate (schema + vocabolario token).",
  "type": "module",
  "scripts": {
    "add:library": "node --import tsx src/library/library-cli.ts add",
    "adopt:variant": "node --import tsx src/library/adopt-cli.ts",
    "bootstrap:library": "node --import tsx src/library/library-cli.ts bootstrap",
    "bump:contract": "node --import tsx src/library/bump-cli.ts",
    "check-types": "tsc --noEmit",
    "extract:component": "node --import tsx src/extract-component.ts extract",
    "gates:render": "node --import tsx src/emitter/gates-cli.ts",
    "generate:theme": "node --import tsx src/generate-theme.ts",
    "lint": "node ./scripts/check-boundaries.mjs",
    "render:check": "node --import tsx src/emitter/render-cli.ts --all --check",
    "render:component": "node --import tsx src/emitter/render-cli.ts",
    "test": "vitest run",
    "validate:recipe": "node --import tsx src/extract-component.ts validate",
    "verify:library": "node --import tsx src/library/library-cli.ts verify"
  },
  "dependencies": {
    "@app/contracts": "workspace:*",
    "@modelcontextprotocol/sdk": "catalog:",
    "@penpot-ds/tokens": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@app/config": "workspace:*",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
