{
  "name": "@penpot-ds/scripts",
  "version": "0.0.0",
  "private": true,
  "description": "Pipeline MCP Penpot→codice v2: due contratti → istantanea → render headless (sei comandi, un guscio).",
  "type": "module",
  "scripts": {
    "check-types": "tsc --noEmit",
    "lint": "node ./scripts/check-boundaries.mjs",
    "test": "vitest run",
    "theme": "node --import tsx src/cli.ts theme",
    "library": "node --import tsx src/cli.ts library",
    "propose": "node --import tsx src/cli.ts propose",
    "extract": "node --import tsx src/cli.ts extract",
    "render": "node --import tsx src/cli.ts render",
    "gates": "node --import tsx src/cli.ts gates"
  },
  "dependencies": {
    "@app/contracts": "workspace:*",
    "@modelcontextprotocol/sdk": "catalog:",
    "@penpot-ds/tokens": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@app/config": "workspace:*",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
