{
  "name": "@penpot-ds/scripts",
  "version": "0.0.0",
  "private": true,
  "description": "Pipeline MCP Penpot\u2192codice: Stage 1 genera i token di @penpot-ds/tokens, Stage 2 estrae per-componente fixture e ricette validate (schema + vocabolario token).",
  "type": "module",
  "scripts": {
    "add:library": "node --import tsx src/cli/library.ts add",
    "adopt:variant": "node --import tsx src/cli/adopt-variant.ts",
    "bootstrap:library": "node --import tsx src/cli/library.ts bootstrap",
    "bump:contract": "node --import tsx src/cli/bump-contract.ts",
    "check-types": "tsc --noEmit",
    "extract:component": "node --import tsx src/cli/extract-component.ts extract",
    "gates:render": "node --import tsx src/cli/gates-render.ts",
    "generate:theme": "node --import tsx src/cli/generate-theme.ts",
    "lint": "node ./scripts/check-boundaries.mjs",
    "render:check": "node --import tsx src/cli/render-component.ts --all --check",
    "render:component": "node --import tsx src/cli/render-component.ts",
    "role:part": "node --import tsx src/cli/role-part.ts",
    "sync:design": "node --import tsx src/cli/sync-design.ts",
    "test": "vitest run",
    "theme": "node --import tsx src/v2/cli.ts theme",
    "library": "node --import tsx src/v2/cli.ts library",
    "propose": "node --import tsx src/v2/cli.ts propose",
    "extract": "node --import tsx src/v2/cli.ts extract",
    "render": "node --import tsx src/v2/cli.ts render",
    "validate:recipe": "node --import tsx src/cli/extract-component.ts validate",
    "verify:library": "node --import tsx src/cli/library.ts verify"
  },
  "dependencies": {
    "@app/contracts": "workspace:*",
    "@modelcontextprotocol/sdk": "catalog:",
    "@penpot-ds/tokens": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@app/config": "workspace:*",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
