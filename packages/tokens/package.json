{
  "name": "@penpot-ds/tokens",
  "version": "0.0.0",
  "private": true,
  "description": "Design token generati dal catalogo Penpot (colori/tipografia/spacing/radii/ombre/font). Non editare a mano i file @generated — rigenera con lo strumento `extract_theme` del server pds.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./scales": "./src/tokens.generated.ts",
    "./theme.css": "./src/theme.css",
    "./fonts.css": "./src/fonts.css",
    "./themes/*": "./src/themes/*",
    "./tailwind-extras.css": "./src/tailwind-extras.css"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --out-dir dist",
    "check-types": "tsc --noEmit",
    "lint": "node ./scripts/check-boundaries.mjs"
  },
  "devDependencies": {
    "@app/config": "workspace:*",
    "tsup": "catalog:",
    "typescript": "catalog:"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0"
  }
}
